# Telegram API credentials from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash_here

# Server configuration
PORT=3000
NODE_ENV=production

# Secret used to sign browser auth cookies / stream tokens (change in production!)
APP_SECRET=change_this_to_a_long_random_secret_string

# Streaming cache settings
STREAM_CACHE_MAX_MB=256

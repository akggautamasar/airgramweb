# Telegram API credentials from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash_here

# Server configuration
PORT=3000
NODE_ENV=production

# Secret used to sign browser auth cookies / stream tokens (change in production!)
APP_SECRET=change_this_to_a_long_random_secret_string

# Streaming cache settings
STREAM_CACHE_MAX_MB=256

# ── Fast Cloner (AirSaver-style) ────────────────────────────────────────────
# Parallel media downloads in re-upload mode
CLONE_PARALLEL=4
# Files ≤ this size (MB) stay in RAM (no disk)
CLONE_INMEM_MB=200
# Reject single files larger than this (MB)
CLONE_MAX_FILE_MB=2048
# Messages per forwardMessages batch
CLONE_FORWARD_BATCH=50
# GramJS parallel connections for download / upload
CLONE_DL_WORKERS=8
CLONE_UL_WORKERS=8
# Extra delay after FLOOD_WAIT seconds (ms)
CLONE_FLOOD_BASE_MS=1500
# Optional override for job checkpoint dir
# CLONE_DATA_DIR=./clone-data
